    },
    "EVH1_FPPPP": {
      "pattern": "[FW]PPPP",
      "context": "whole_sequence",
      "regions": [],
      "interpretation": "Conservative EVH1 ligand core screen; flanks and accessibility matter; not zyxin-specific.",
