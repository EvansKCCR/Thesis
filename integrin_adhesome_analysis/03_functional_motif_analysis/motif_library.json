  "scope": "Conservative inspection panel, not exhaustive signatures or a classifier.",
  "motifs": {
    "alpha_signature": {
      "pattern": "[FYWS][RK].GFF.R",
      "context": "c_terminal_window",
      "regions": [
        "cytoplasmic_tail"
      ],
      "interpretation": "PROSITE alpha signature; independent architecture and topology required.",
      "source": "https://prosite.expasy.org/PS00242",
      "window": 100
    },
    "alpha_GFFxR": {
      "pattern": "GFF.R",
      "context": "c_terminal_window",
      "regions": [
        "cytoplasmic_tail"
      ],
      "interpretation": "Relaxed alpha core, lower specificity than full signature; tail window is not topology.",
      "source": "../01_detection/config/family_rules.json",
      "window": 100
    },
    "beta_NPxY": {
      "pattern": "NP.Y",
      "context": "c_terminal_window",
      "regions": [
        "cytoplasmic_tail"
      ],
      "interpretation": "Candidate adaptor site; membrane proximal/distal assignment requires topology and alignment.",
      "source": "../01_detection/config/family_rules.json",
      "window": 100
    },
    "beta_NxxYF": {
      "pattern": "N..[YF]",
      "context": "c_terminal_window",
      "regions": [
        "cytoplasmic_tail"
      ],
      "interpretation": "Broad variant screen including NPxY; nested hits are not independent evidence or binding proof.",
      "source": "../01_detection/config/family_rules.json",
      "window": 100
    },
    "MIDAS_core": {
      "pattern": "D.S.S",
      "context": "domain",
      "regions": [
        "PF00362",
        "PF00092"
      ],
      "interpretation": "Partial metal-binding pattern; domain and other coordinating residues required. Alpha-I is optional.",
      "source": "../01_detection/config/family_rules.json"
    },
    "RGD": {
      "pattern": "RGD",
      "context": "domain",
      "regions": [
        "PF00041"
      ],
      "interpretation": "Short ligand candidate; FNIII context and structural accessibility required; not fibronectin or binding proof.",
      "source": "../01_detection/config/family_rules.json"
    },
    "PHSRN": {
      "pattern": "PHSRN",
      "context": "domain",
      "regions": [
        "PF00041"
      ],
      "interpretation": "Canonical fibronectin synergy screen; absence in divergent candidates does not exclude family.",
      "source": "../01_detection/references/motifs/adhesome_motif.json"
