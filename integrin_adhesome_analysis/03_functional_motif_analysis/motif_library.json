      "pattern": "GFPGER",
      "context": "domain",
      "regions": [
        "PF01391"
      ],
      "interpretation": "Encoded GFOGER precursor; hydroxylation and triple-helical context unknown. O is not hydroxyproline.",
      "source": "../01_detection/config/family_rules.json"
    },
    "collagen_GXY_run": {
      "pattern": "(?:G..){5,}",
      "context": "whole_sequence",
      "regions": [],
      "interpretation": "Heuristic: at least five GXY units; repeat composition alone does not establish collagen identity.",
      "source": "Local exploratory repeat rule, not a curated diagnostic signature"
    },
    "PxxP": {
      "pattern": "P..P",
      "context": "whole_sequence",
      "regions": [],
